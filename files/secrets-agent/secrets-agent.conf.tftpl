# Managed by terraform-setup-environment. Holds the credential that unlocks every
# secret for this host, so the agent refuses to run unless this file is root:0600.
AGENT_URL=${url}
AUTH_HEADERS=${auth_headers}
STATE_DIR=${state_dir}
TF_ENV=${state_dir}/terraform.env
ROUTING_FILE=/etc/secrets-agent.files
FILES_MODE=${files_mode}
%{ if compose_file != "" ~}
COMPOSE_FILE=${compose_file}
%{ endif ~}
%{ if systemd_units != "" ~}
SYSTEMD_UNITS=${systemd_units}
%{ endif ~}
